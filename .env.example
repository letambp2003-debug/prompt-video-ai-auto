# App Configuration
APP_URL=http://localhost:3000

# AI Provider (gemini | mock)
AI_PROVIDER=gemini
GEMINI_API_KEY=

# Generation Modes (PROMPT_ONLY | API_PROVIDER)
VIDEO_MODE=PROMPT_ONLY
IMAGE_MODE=PROMPT_ONLY

# Optional Video Provider
VIDEO_PROVIDER=mock
VIDEO_API_KEY=

# Database / Persistence (local_file | sqlite | postgres)
DATABASE_URL=
PERSISTENCE_MODE=local_file

# Storage Provider (local | s3)
STORAGE_PROVIDER=local
STORAGE_BUCKET=./data/storage

# Auth Mode (none | local | supabase)
AUTH_MODE=none
